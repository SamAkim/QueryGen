
<body>
    <div id="loader" class="hidden">
        <div class="loader-content">
            <div class="loader-spinner"></div>
            <p>Processing Request</p>
        </div>
    </div>

    <div id="auth-container">
        <div class="auth-background">
            <div class="auth-pattern"></div>
        </div>
        <div class="auth-box">
            <div class="app-brand">
                <div class="logo">
                    <i class="fas fa-bolt"></i>
                </div>
                <h1>QueryGen AI</h1>
                <p class="tagline">Enterprise SQL Generation Platform</p>
            </div>
            
            <div class="auth-tabs">
                <button id="show-login-tab" class="auth-tab-btn active">
                    <i class="fas fa-sign-in-alt"></i>
                    Sign In
                </button>
                <button id="show-register-tab" class="auth-tab-btn">
                    <i class="fas fa-user-plus"></i>
                    Register
                </button>
            </div>

            <form id="login-form" class="auth-form">
                <div class="form-group">
                    <div class="input-with-icon">
                        <i class="fas fa-user"></i>
                        <input type="text" id="login-username" placeholder="Username" required>
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-with-icon">
                        <i class="fas fa-lock"></i>
                        <input type="password" id="login-password" placeholder="Password" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-full">
                    <i class="fas fa-sign-in-alt"></i>
                    Sign In
                </button>
            </form>

            <form id="register-form" class="auth-form hidden">
                <div class="form-group">
                    <div class="input-with-icon">
                        <i class="fas fa-user"></i>
                        <input type="text" id="register-username" placeholder="Username" required>
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-with-icon">
                        <i class="fas fa-lock"></i>
                        <input type="password" id="register-password" placeholder="Password" required>
                    </div>
                </div>
                <div class="form-group">
                    <div class="input-with-icon">
                        <i class="fas fa-check-circle"></i>
                        <input type="password" id="register-confirm-password" placeholder="Confirm Password" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-full">
                    <i class="fas fa-user-plus"></i>
                    Create Account
                </button>
            </form>
            <div id="auth-error" class="error-message hidden"></div>
        </div>
    </div>

    <div id="app-wrapper" class="hidden">
        <aside id="sidebar">
            <div class="sidebar-header">
                <div class="app-brand">
                    <div class="logo">
                        <i class="fas fa-bolt"></i>
                    </div>
                    <h2>QueryGen AI</h2>
                </div>
            </div>
            
            <nav id="sidebar-nav">
                <button class="nav-btn active" data-page="query">
                    <i class="fas fa-comments"></i>
                    <span class="nav-text">AI Chat</span>
                </button>
                <button class="nav-btn" data-page="projects">
                    <i class="fas fa-folder"></i>
                    <span class="nav-text">Projects</span>
                </button>
                <button class="nav-btn" data-page="query_history">
                    <i class="fas fa-history"></i>
                    <span class="nav-text">Query History</span>
                </button>
                <button class="nav-btn admin-only" data-page="analytics">
                    <i class="fas fa-chart-bar"></i>
                    <span class="nav-text">Analytics</span>
                </button>
            </nav>

            <div class="sidebar-footer">
                <div class="user-profile">
                    <div class="user-avatar">
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="user-info">
                        <div id="username-display" class="user-name">Loading...</div>
                    </div>
                </div>
                <button id="logout-btn" class="btn btn-secondary btn-full">
                    <i class="fas fa-sign-out-alt"></i>
                    Sign Out
                </button>
            </div>
        </aside>

        <main id="main-content">
             <div id="main-error" class="error-message hidden"></div>
            <div id="query-page" class="page-content active">
                <div class="page-header">
                    <h2>AI SQL Assistant</h2>
                    <p>Generate SQL queries from natural language using your project documents.</p>
                </div>
                
                <div class="card project-selector-card">
                    <div class="card-header">
                        <h3><i class="fas fa-database"></i> Select Project</h3>
                    </div>
                    <div class="card-content">
                        <select id="query-project-selector" class="modern-select">
                            <option value="">Choose a project to query...</option>
                        </select>
                    </div>
                </div>

                <div class="card chat-card">
                    <div class="card-header">
                        <h3><i class="fas fa-comments"></i> Chat Interface</h3>
                        <div class="card-actions">
                            <button id="clear-chat-btn" class="btn btn-sm btn-secondary">
                                <i class="fas fa-trash"></i> Clear Chat
                            </button>
                        </div>
                    </div>
                    <div class="card-content">
                        <div id="chat-container">
                            <div id="chat-messages">
                                <div class="welcome-message">
                                    <div class="welcome-icon">
                                        <i class="fas fa-robot"></i>
                                    </div>
                                    <h3>Welcome to QueryGen AI</h3>
                                    <p>Select a project and start asking questions about your data!</p>
                                </div>
                            </div>
                        </div>
                        <form id="chat-form" class="chat-input-form">
                            <div class="chat-input-container">
                                <input type="text" id="chat-input" placeholder="Ask about your data (e.g., show me all customers from London)" required>
                                <button type="submit" class="btn btn-primary btn-icon">
                                    <i class="fas fa-paper-plane"></i>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div id="projects-page" class="page-content">
                <div class="page-header">
                    <h2>Project Management</h2>
                    <p>Create and manage your SQL generation projects.</p>
                </div>
                
                <div class="card">
                    <div class="card-header">
                        <h3><i class="fas fa-plus-circle"></i> Create New Project</h3>
                    </div>
                    <div class="card-content">
                        <form id="create-project-form" class="project-form">
                            <div class="form-group">
                                <input type="text" id="new-project-name" placeholder="Enter project name" required>
                            </div>
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-plus"></i> Create Project
                            </button>
                        </form>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h3><i class="fas fa-folder-open"></i> Your Projects</h3>
                    </div>
                    <div class="card-content">
                        <div id="projects-grid" class="projects-grid">
                            </div>
                    </div>
                </div>
            </div>

            <div id="project-detail-page" class="page-content">
                <div class="page-header">
                     <button id="back-to-projects-btn" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Projects
                    </button>
                    <h2 id="project-detail-title">Project Details</h2>
                    <p>Manage documents and settings for your project.</p>
                </div>
                
                <div class="tabs">
                    <button class="tab-btn active" data-tab="upload">
                        <i class="fas fa-upload"></i> Upload New
                    </button>
                    <button class="tab-btn" data-tab="manage">
                        <i class="fas fa-file-alt"></i> Manage Existing
                    </button>
                </div>

                <div id="upload-tab-content" class="tab-content active">
                    <div class="card">
                        <div class="card-header">
                            <h3><i class="fas fa-cloud-upload-alt"></i> Upload Documents</h3>
                        </div>
                        <div class="card-content">
                            <form id="upload-form">
                                <div class="upload-area" id="upload-area">
                                    <div class="upload-icon">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                    </div>
                                    <p>Drag & drop files here or click to browse</p>
                                    <p class="upload-info">Supported: PDF, CSV, XLSX, DOCX, TXT</p>
                                    <input type="file" id="file-upload" multiple class="hidden">
                                </div>
                                <div class="file-list" id="file-list-preview">
                                    </div>
                                <button type="submit" class="btn btn-primary btn-full">
                                    <i class="fas fa-upload"></i> Upload and Process Files
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <div id="manage-tab-content" class="tab-content">
                    <div class="card">
                        <div class="card-header">
                            <h3><i class="fas fa-file-alt"></i> Project Documents</h3>
                        </div>
                        <div class="card-content">
                            <div id="document-list">
                                </div>
                        </div>
                    </div>
                </div>
            </div>

            <div id="query_history-page" class="page-content">
                <div class="page-header">
                    <h2>Query History</h2>
                    <p>Review your past SQL queries and conversations.</p>
                </div>
                
                <div class="card">
                    <div class="card-header">
                        <h3><i class="fas fa-history"></i> Conversation History</h3>
                    </div>
                    <div class="card-content">
                        <div class="history-controls">
                            <select id="history-project-selector" class="modern-select">
                                <option value="">Select Project</option>
                            </select>
                            <select id="history-conversation-selector" class="modern-select">
                                <option value="">Select Conversation</option>
                            </select>
                        </div>
                        <div id="history-transcript" class="history-transcript">
                            </div>
                    </div>
                </div>
            </div>

            <div id="analytics-page" class="page-content">
                <div class="page-header">
                    <h2>Analytics Dashboard</h2>
                    <p>Platform usage statistics and performance metrics.</p>
                </div>
                
                <div id="kpi-container" class="analytics-grid">
                    </div>

                 <div class="tabs">
                    <button class="tab-btn active" data-tab="trends">📈 Query & Project Trends</button>
                    <button class="tab-btn" data-tab="performance">⚙️ Performance Metrics</button>
                    <button class="tab-btn" data-tab="feedback">👍 Feedback Analysis</button>
                </div>

                <div id="trends-tab-content" class="tab-content chart-container card active">
                     <div class="card-header"><h3><i class="fas fa-chart-line"></i> Query Volume Trend</h3></div>
                     <div class="card-content"><div class="chart-wrapper"><canvas id="query-trend-chart"></canvas></div></div>
                </div>

                <div id="performance-tab-content" class="tab-content chart-container card">
                     <div class="card-header"><h3><i class="fas fa-tachometer-alt"></i> Performance Metrics</h3></div>
                     <div class="card-content"><div id="perf-kpi-container" class="perf-kpi-grid"></div></div>
                </div>

                <div id="feedback-tab-content" class="tab-content chart-container card">
                    <div class="card-header"><h3><i class="fas fa-thumbs-up"></i> User Feedback</h3></div>
                    <div class="card-content"><div class="chart-wrapper"><canvas id="feedback-chart"></canvas></div></div>
                </div>
            </div>
        </main>
    </div>

    <script src="script.js"></script>
</body>
